# Gemini-only configuration. Add a personal Google AI Studio key in `.env`.
# Never place a real credential in this template or commit it to source control.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated frontend origins permitted to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
