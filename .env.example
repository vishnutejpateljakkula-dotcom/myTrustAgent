# Choose one provider. Add a personal key in `.env`; never commit it.
# Never place a real credential in this template or commit it to source control.
# Groq uses its OpenAI-compatible chat-completions endpoint.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini is optional. Use LLM_PROVIDER=gemini to enable it instead of Groq.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Per-request time limit for the provider. Lower values return safe fallbacks faster.
LLM_TIMEOUT_SECONDS=12
# Comma-separated frontend origins permitted to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
